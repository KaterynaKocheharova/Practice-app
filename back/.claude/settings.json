{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/bash-guard.ps1\"",
            "timeout": 15,
            "statusMessage": "Checking shell command against team policy..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/format.ps1\"",
            "timeout": 30,
            "statusMessage": "Auto-formatting (prettier --write)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/notify-stop.ps1\"",
            "timeout": 10,
            "async": true,
            "statusMessage": "Notifying..."
          }
        ]
      }
    ]
  }
}
