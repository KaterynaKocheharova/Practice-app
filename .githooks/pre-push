#!/bin/sh
# Blocks any push that updates or deletes main/master on the remote.
# Git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>
# Enabled via: git config core.hooksPath .githooks

protected='^refs/heads/(main|master)$'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    if printf '%s\n' "$remote_ref" | grep -Eq "$protected"; then
        echo "pre-push: pushing to '${remote_ref#refs/heads/}' is blocked. Push a feature branch and open a PR." >&2
        status=1
    fi
done

exit $status
